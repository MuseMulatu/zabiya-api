generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Assuming PostgreSQL for production
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(uuid())
  phone_encrypted  String     // Symmetrically encrypted
  telegram_chat_id String?    @unique
  telegram_username_enc String?
  gender           String?    // 'male', 'female'
  birth_date       DateTime?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  last_notified_at DateTime?

  aliases          Alias[]
  intents          Intent[]
  matches_a        Match[]    @relation("UserAMatches")
  matches_b        Match[]    @relation("UserBMatches")
  purchases        Purchase[]
  wallet           Wallet?
  transactions     Transaction[] // Added relation
  
  blocked_users Block[] @relation("BlockedUsers")
  blocked_by    Block[] @relation("BlockedBy")
}

model TelebirrReceipt {
  id             String   @id @default(uuid())
  transaction_id String   @unique
  amount         Float
  sender_name    String?  // Optional, just for your own logging
  status         String   @default("UNCLAIMED") // UNCLAIMED or CLAIMED
  created_at     DateTime @default(now())
}

model Transaction {
  id           String   @id @default(uuid())
  user_id      String
  session_id   String?  @unique // Populated after Arifpay responds
  nonce        String   @unique
  amount       Float
  package_type String   // 'basic' or 'premium'
  status       String   @default("PENDING") // PENDING, SUCCESS, FAILED, EXPIRED, CANCELED
  checkout_url String?
  expire_date  DateTime
  
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}


model Wallet {
  id             String   @id @default(uuid())
  user_id        String   @unique
  // 👈 THE UNIFIED CURRENCY
  slots_balance  Int      @default(0) 
  
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Alias {
  id                  String   @id @default(uuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type                String   // 'phone', 'telegram', 'instagram'
  hashed_value        String   // SHA-256 hashed value (identifier + PEPPER)
  encrypted_value     String?  // 👈 NEW: Stores the 2-way locked string
  verified            Boolean  @default(false)
  verification_method String?  // e.g., 'telegram_auth', 'sms_otp', 'oauth'
  created_at          DateTime @default(now())

  @@index([hashed_value])
  @@unique([user_id, type, hashed_value])
}



model Intent {
  id               String   @id @default(uuid())
  user_id          String
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  type             String   // e.g., 'phone', 'telegram', 'instagram'
  target_hash      String   // Hashed identifier (used by the match engine)
  target_encrypted String   // Encrypted identifier (used to show the user their dashboard)
  
  created_at       DateTime @default(now())
  expires_at       DateTime

  @@index([target_hash]) 
  @@unique([user_id, target_hash]) 
  status           String   @default("ACTIVE") // 'ACTIVE' or 'REVOKED'
}
model Match {
  id         String   @id @default(uuid())
  user_a_id  String
  user_a     User     @relation("UserAMatches", fields: [user_a_id], references: [id], onDelete: Cascade)
  user_b_id  String
  user_b     User     @relation("UserBMatches", fields: [user_b_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([user_a_id, user_b_id]) // Prevent duplicate match records
  status           String   @default("ACTIVE") // 'ACTIVE' or 'BLOCKED'
}

model Block {
  id          String   @id @default(uuid())
  blocker_id  String
  blocked_id  String
  created_at  DateTime @default(now())

  // Relations required to fetch the blocked user's details
  blocker     User     @relation("BlockedUsers", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlockedBy", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
}

model Purchase {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String   // 'intent_slots', 'alias_slots'
  quantity   Int
  status     String   // 'pending', 'completed', 'failed'
  created_at DateTime @default(now())
}

model OtpRequest {
  id         String   @id @default(uuid())
  phone      String   @unique
  otp_code   String
  expires_at DateTime
  created_at DateTime @default(now())
}

//Nest Junior Ride ***************************************

// --- USERS & ROLES ---

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique // Links to React Native auth().currentUser.uid
  name          String
  phone         String
  role          Role     @default(PARENT) // PARENT, DRIVER, ADMIN
  
  // A parent can have multiple kids, and a kid can have multiple parents (Many-to-Many)
  childrenLinks ParentStudent[]
  
  // If the user is a driver, link to their driver profile
  driverProfile DriverProfile?
  
  createdAt     DateTime @default(now())
}

enum Role {
  PARENT
  DRIVER
  ADMIN
}

// --- DRIVER POOL ---

model DriverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  
  approvalStatus  ApprovalStatus @default(PENDING)
  carModel        String?
  plateNumber     String?
  seats           Int      @default(4)
  
  // Drivers are assigned to specific daily routes
  assignedRoutes  RouteSubscription[]
}

enum ApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
}

// --- STUDENTS & ROUTES ---

model Student {
  id            String   @id @default(uuid())
  name          String
  schoolName    String
  photoUrl      String?
  
  parents       ParentStudent[]
  subscriptions RouteSubscription[]
}

// Join table for Many-to-Many relationship
model ParentStudent {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])

  @@id([userId, studentId])
}

// --- THE CORE BUSINESS LOGIC ---

model RouteSubscription {
  id              String   @id @default(uuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  
  // Nullable until Admin assigns a driver from the pool
  driverId        String?
  driver          DriverProfile? @relation(fields: [driverId], references: [id])
  
  type            PlanType // PRIVATE or SHARED
  
  // Exact Coordinates
  pickupLat       Float
  pickupLng       Float
  pickupAddress   String
  dropoffLat      Float
  dropoffLng      Float
  dropoffAddress  String
  
  // Financials
  paymentStatus   PaymentStatus @default(UNPAID)
  monthlyFee      Float
  
  // --- THE LIVE STREAM LINK ---
  // The programmatically created 100ms room. 
  // Parent & Driver fetch this specific ID to connect.
  hmsRoomId       String?  @unique 
  
  dailyLookInCount Int       @default(0)
  lastLookInDate   DateTime?
  
  createdAt       DateTime @default(now())
}

enum PlanType {
  PRIVATE
  SHARED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION // Parent uploaded receipt
  ACTIVE               // Admin verified payment
  EXPIRED
}